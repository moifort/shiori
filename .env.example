NITRO_GOOGLE_API_KEY=...
NITRO_ADMIN_TOKEN=your-admin-token
NITRO_SENTRY_DSN=
# Sentry user auth token (sntryu_...) — used only for local error triage tooling (read + resolve issues via the REST API). Not a runtime config.
SENTRY_AUTH_TOKEN=
# Dev-only: Firebase UID injected by the auth bypass so Apollo Sandbox works locally without a token.
NITRO_DEV_USER_ID=
# Set to 1 to answer every scan with a fixed book instead of calling Gemini. Used by scripts/e2e.sh.
NITRO_SCAN_STUB=
# 256-bit key, base64, sealing the Audible device credentials at rest. Generate one with:
# openssl rand -base64 32
NITRO_AUDIBLE_KEY=
# Push notifications through APNs, all three or none: the id of an Apple key with
# the APNs service enabled, its .p8 content, and the team it belongs to. Blank
# leaves the release alerts logged instead of sent.
NITRO_APNS_KEY_ID=
NITRO_APNS_PRIVATE_KEY=
NITRO_APNS_TEAM_ID=
